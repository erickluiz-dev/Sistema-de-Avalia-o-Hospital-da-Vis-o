# URL de conexão com o PostgreSQL
DATABASE_URL=postgres://usuario:senha@host:5432/database

# Porta utilizada pelo servidor HTTP
PORT=8080

# CIDRs dos proxies reversos confiáveis.
# Separe múltiplas redes por vírgula.
TRUSTED_PROXY_CIDRS=

FrontendURL=http://localhost:8443,https://sistema-de-avali-o-hospital-da-vis.vercel.app